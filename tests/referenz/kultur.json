 "haushalt_schritte": [
  {
   "text": "Die Ämter melden ihren Bedarf im Rahmen von Eckwerten je Amt und Dezernat; Mehrbedarf ist innerhalb des Dezernats auszugleichen. Der Verwaltungsvorstand bespricht Härtefälle. Dieser Teil ist nicht öffentlich.",
   "titel": "Aufstellung in der Verwaltung",
   "zeit": "Frühjahr und Sommer 2026"
  },
  {
   "text": "Die Verwaltung legt dem Rat den Entwurf des Haushaltsplans vor; die Mitglieder der Ausschüsse erhalten die Unterlagen.",
   "titel": "Einbringung des Entwurfs",
   "zeit": "Herbst 2026"
  },
  {
   "text": "Jedes Fachgremium berät den Entwurf einmal, für die Kultur der Kulturausschuss. Fraktionen können Änderungsanträge stellen.",
   "titel": "Beratung in den Fachausschüssen und Bezirksvertretungen",
   "zeit": "Oktober und November 2026"
  },
  {
   "text": "Er tagt nach den Fachgremien und bereitet den Beschluss des Rates vor.",
   "titel": "Ausschuss für Finanzen, Beteiligungen und Vergabe",
   "zeit": "November 2026"
  },
  {
   "text": "Etwa zwei Wochen nach dem Finanzausschuss beschließt der Rat die Haushaltssatzung.",
   "titel": "Beschluss im Rat",
   "zeit": "Dezember 2026"
  },
  {
   "text": "Die Satzung geht an die Bezirksregierung Köln; die Genehmigung erwartet die Verwaltung im ersten Quartal 2027.",
   "titel": "Kommunalaufsicht",
   "zeit": "Anfang 2027"
  }
 ],
