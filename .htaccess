# Für den Betrieb auf einem eigenen Apache-Server (z. B. Plesk); wird als .htaccess in den
# Branch deploy kopiert. Die Daten für ganz Bonn umfassen rund 85 MB JSON; Komprimierung
# verringert die Übertragung auf etwa ein Zehntel.
AddDefaultCharset utf-8
AddType application/json .json
AddType application/geo+json .geojson
AddType text/tab-separated-values .tsv
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddCharset utf-8 .json .geojson .tsv .md .js .css

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/geo+json text/tab-separated-values text/markdown
</IfModule>

# Daten werden täglich neu erzeugt
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/geo+json "access plus 1 day"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
</IfModule>

RedirectMatch 404 /\.git
ErrorDocument 404 /404.html
